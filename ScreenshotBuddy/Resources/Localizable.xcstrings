    "No readable QR code found. Try a sharper crop with more white margin around the code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No readable QR code found. Try a sharper crop with more white margin around the code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen leesbare QR-code gevonden. Probeer een scherpere uitsnede met meer witte rand rond de code."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum QR code legível encontrado. Tente um recorte mais nítido com mais margem branca ao redor do código."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un código QR legible. Prueba un recorte más nítido con más margen blanco alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun code QR lisible trouvé. Essayez un recadrage plus net avec plus de marge blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun codice QR leggibile trovato. Prova un ritaglio più nitido con più margine bianco."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على رمز QR قابل للقراءة. جرّب قصًا أوضح مع هامش أبيض أكبر حول الرمز."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可读的二维码。请尝试更清晰的裁剪，并在码周围留出更多白边。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаемый QR-код не найден. Попробуйте более чёткий кадр с большим белым полем вокруг кода."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れるQRコードがありません。コード周りに余白を多めにしたシャープな切り抜きを試してください。"
          }
        }
      }
    },

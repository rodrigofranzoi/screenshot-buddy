    "Type in the box. Drag the handle to move. Click outside to confirm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type in the box. Drag the handle to move. Click outside to confirm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ in het vak. Sleep het handvat om te verplaatsen. Klik buiten om te bevestigen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite na caixa. Arraste a alça para mover. Clique fora para confirmar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en la caja. Arrastra el controlador para mover. Haz clic fuera para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez dans la zone. Faites glisser la poignée pour déplacer. Cliquez dehors pour confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita nella casella. Trascina la maniglia per spostare. Fai clic fuori per confermare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب في المربع. اسحب المقبض للنقل. انقر خارجًا للتأكيد."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在框中输入。拖动手柄移动。点击外部确认。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите текст в поле. Перетащите маркер для перемещения. Кликните снаружи, чтобы подтвердить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枠内に入力。ハンドルで移動。外側をクリックして確定。"
          }
        }
      }
    },

    "Same soft blur as the sensitive preview.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same soft blur as the sensitive preview."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde zachte vervaging als bij de gevoelige voorvertoning."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo desfoque suave da prévia sensível."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo desenfoque suave que la vista previa sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même flou doux que l’aperçu sensible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stessa sfocatura morbida dell’anteprima sensibile."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفس التمويه الناعم المستخدم في معاينة المحتوى الحساس."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "与敏感预览相同的柔和模糊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То же мягкое размытие, что и в скрытом превью."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密プレビューと同じ柔らかいぼかしです。"
          }
        }
      }
    },
    "Select text in the image like Preview. Use ⌘C or Copy Text.": {
      "localizations": {
        "en": {

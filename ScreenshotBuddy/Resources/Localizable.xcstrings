    "Drag handles to resize, drag inside the box to move, or drag on the image to select an area. Then confirm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag handles to resize, drag inside the box to move, or drag on the image to select an area. Then confirm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep handvatten om te schalen, sleep in het vak om te verplaatsen, of sleep op de afbeelding om een gebied te selecteren. Bevestig daarna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as alças para redimensionar, arraste dentro da caixa para mover, ou arraste na imagem para selecionar uma área. Depois confirme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controladores para redimensionar, dentro de la caja para mover, o en la imagen para seleccionar un área. Luego confirma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées pour redimensionner, l’intérieur pour déplacer, ou sur l’image pour sélectionner. Puis confirmez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie per ridimensionare, l’interno per spostare, o sull’immagine per selezionare un’area. Poi conferma."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المقابض لتغيير الحجم، أو داخل المربع للنقل، أو على الصورة لتحديد منطقة. ثم أكّد."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄调整大小，拖动框内移动，或在图像上拖选区域，然后确认。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяните маркеры для размера, внутри рамки — для перемещения, по изображению — для выбора области. Затем подтвердите."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグしてサイズ変更、枠内で移動、画像上で範囲選択。その後確定します。"
          }
        }
      }
    },

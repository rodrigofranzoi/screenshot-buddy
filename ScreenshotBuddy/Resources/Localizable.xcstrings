    "Click a pixel to copy its hex color.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a pixel to copy its hex color."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een pixel om de hex-kleur te kopiëren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um pixel para copiar a cor hex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un píxel para copiar su color hex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un pixel pour copier sa couleur hex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un pixel per copiare il colore esadecimale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على بكسل لنسخ لونه الست عشري."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击像素以复制其十六进制颜色。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на пиксель, чтобы скопировать hex-цвет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクセルをクリックしてHEXカラーをコピーします。"
          }
        }
      }
    },
    "Click the image to place text, or click existing text to edit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the image to place text, or click existing text to edit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de afbeelding om tekst te plaatsen, of op bestaande tekst om te bewerken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na imagem para colocar texto, ou em texto existente para editar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la imagen para colocar texto, o en texto existente para editarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’image pour placer du texte, ou sur un texte existant pour le modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’immagine per inserire testo, o sul testo esistente per modificarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الصورة لوضع نص، أو على نص موجود لتحريره."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图像以放置文字，或点击已有文字进行编辑。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на изображение, чтобы добавить текст, или на существующий текст для правки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をクリックしてテキストを配置するか、既存のテキストをクリックして編集します。"
          }
        }
      }
    },
